{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1a examples/button_example.py + Chrome",
      "type": "debugpy",
      "request": "launch",
      "module": "examples.button_example",
      "justMyCode": false,
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "env": {
        "PYTHONPATH": "${cwd}/src",
      },
      "serverReadyAction": {
        "pattern": "Uvicorn running on\\s+(https?://\\S+)",
        "uriFormat": "%s/",
        "action": "debugWithChrome",
        "killOnServerStop": true
      }
    },
    {
      "name": "2a. PyTest (tests/test_component.py)",
      "type": "debugpy",
      "request": "launch",
      "stopOnEntry": false,
      "module": "pytest",
      "args": [
        "tests/test_component.py"
      ],
      "cwd": "${workspaceRoot}",
      "envFile": "${workspaceRoot}/.env",
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "justMyCode": false,
    },
    {

      "name": "3a Launch Chrome",
      "request": "launch",
      "type": "chrome",
      "url": "http://127.0.0.1:8000",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "internalConsoleOptions": "openOnSessionStart",

      "sourceMapPathOverrides": {

        // Map relative paths from source map (../../js/src/* -> src/js/src/*)

        "../../js/src/*": "${webRoot}/src/js/src/*",
        "../../js/node_modules/*": "${webRoot}/src/js/node_modules/*",

        // Catch-all for WSL path resolution issues (Windows-style absolute paths)

        "**/my-reactpy-package/js/src/*": "${webRoot}/src/js/src/*",
        "**/my-reactpy-package/js/node_modules/*": "${webRoot}/src/js/node_modules/*",
      },

      "pathMapping": {
        "/js/src": "${workspaceFolder}/src/js/src",
        "/reactpy/modules": "${workspaceFolder}/src/my_reactpy_package/static"
      },

      // Mask debug console messages of the form: Could not read source map for ...

      "resolveSourceMapLocations": [
        "!**/node_modules/**",
        "!**/packages/**"
      ],

      "showAsyncStacks": true
    },

    // 
    // Build dev version of browser code and launch button_example.py
    // without instantiating the browser. This configuration is used
    // to debug the browser.
    {
      "name": "3b examples/button_example.py",
      "type": "debugpy",
      "request": "launch",
      "module": "examples.button_example",
      "justMyCode": false,
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "env": {
        "PYTHONPATH": "${cwd}/src",
      },
      "preLaunchTask": "hatch run javascript:build-dev"
    }


  ],
  "compounds": [
    {
      "name": "3. Debug Server & Browser",
      "configurations": [
        "3b examples/button_example.py",
        "3a Launch Chrome",
      ]
    }
  ]
}